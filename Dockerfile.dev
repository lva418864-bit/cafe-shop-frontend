# Local Development Next.js Dockerfile with Hot Reload
FROM node:22-alpine

WORKDIR /app

# Install dependencies strictly from lockfile first for layer caching
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code
COPY . .

ENV PORT=3000
ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true

EXPOSE 3000

CMD ["npm", "run", "dev"]
